# Basic authentication (src/middleware.ts)
# Required for `next build` + `next start` and for every deployment.
# When unset, the site is refused with 503 outside development.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Firebase configuration
# Get these values from Firebase Console > Project settings > Your apps > Web app
# Vercel: Set these in Project Settings > Environment Variables
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Identity Platform tenant for clever (Google sign-in).
# The Firebase project is shared with the management dashboard, so clever users live in their own tenant.
# Access is granted by the allowlist in Firestore (see firestore.rules).
NEXT_PUBLIC_FIREBASE_TENANT_ID=clever-c8e59
